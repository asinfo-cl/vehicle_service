<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_vehicle_reception_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)" />
            <div class="page">
                <div class="oe_structure"/>
                
                <div class="text-center" style="border-bottom: 2px solid black; margin-bottom: 20px;">
                    <h2>VEHICLE RECEPTION AND CONDITION FORM</h2>
                    <p style="margin: 0; font-weight: 600;">SERVICE ORDER: <span t-field="doc.name"/></p>
                </div>

                <div class="row mt-4">
                    <div class="col-6">
                        <strong>CUSTOMER:</strong> <span t-field="doc.partner_id.name"/><br/>
                        <strong>ID/TAX ID:</strong> <span t-field="doc.partner_id.vat"/><br/>
                        <strong>PHONE:</strong> <span t-field="doc.partner_id.phone"/>
                    </div>
                    <div class="col-6 text-right">
                        <strong>VEHICLE:</strong> <span t-field="doc.vehicle_id.brand"/> <span t-field="doc.vehicle_id.model_name"/><br/>
                        <strong>LICENSE PLATE:</strong> <span t-field="doc.vehicle_id.license_plate"/><br/>
                        <strong>MILEAGE:</strong> <span t-field="doc.current_mileage"/><br/>
                        <strong>Fuel:</strong> <span t-field="doc.fuel_level"/>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-12">
                        <h5>Reception Checklist</h5>
                        <table class="table table-sm">
                            <tbody>
                                <tr>
                                    <td><strong>Bodywork Status</strong></td>
                                    <td><span t-field="doc.bodywork_status"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Accessories Included</strong></td>
                                    <td><span t-field="doc.accessories_included"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Dashboard Warning Lights</strong></td>
                                    <td><span t-field="doc.dash_warning_lights"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Symptom / Fault Description</strong></td>
                                    <td><span t-field="doc.symptom_description"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Maximum Authorized Budget</strong></td>
                                    <td><span t-field="doc.max_authorized_budget"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="col-12">
                        <h5>Customer Acceptance</h5>
                        <p>
                            The customer declares having delivered the vehicle in the condition mentioned in this form and authorizes the workshop to proceed with the requested diagnosis and/or repair.
                        </p>
                        <table class="table table-sm">
                            <tbody>
                                <tr>
                                    <td><strong>Customer Name:</strong></td>
                                    <td><span t-field="doc.partner_id.name"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Reception Date:</strong></td>
                                    <td><span t-field="doc.reception_date"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Conditions Accepted:</strong></td>
                                    <td>The vehicle condition and data recorded in this form are accepted.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>



                <div class="row mt-5">
                    <div class="col-6">
                        <strong>Customer Signature</strong>
                        <div style="height: 80px; border-bottom: 1px solid #000; margin-top: 30px;"></div>
                    </div>
                    <div class="col-6">
                        <strong>Workshop Reception Signature</strong>
                        <div style="height: 80px; border-bottom: 1px solid #000; margin-top: 30px;"></div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="sale_order_report_vehicle_data" inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[@id='informations']" position="after">
            <t t-if="doc.service_type == 'repair' and doc.vehicle_id">
                <div class="row mb-3" id="vehicle_info_block">
                    <div class="col-6">
                        <strong>Vehicle:</strong>
                        <div t-field="doc.vehicle_id.display_name"/>
                        <div t-if="doc.vehicle_id.license_plate">
                            <strong>License Plate:</strong> <span t-field="doc.vehicle_id.license_plate"/>
                        </div>
                    </div>
                    <div class="col-6">
                        <div t-if="doc.current_mileage">
                            <strong>Mileage:</strong> <span t-field="doc.current_mileage"/> KM
                        </div>
                        <div t-if="doc.fuel_level">
                            <strong>Fuel:</strong> <span t-field="doc.fuel_level"/>
                        </div>
                    </div>
                </div>
                <div t-if="doc.symptom_description" class="row mb-3">
                    <div class="col-12">
                        <strong>Symptom / Fault Description:</strong>
                        <p t-field="doc.symptom_description" class="m-0"/>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

    <template id="report_vehicle_reception">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="vehicle_service.report_vehicle_reception_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

</odoo>