<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_reception" model="mail.template">
            <field name="name">Service Order Reception</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Reception RO {{ object.name }}</field>
            <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="use_default_to" eval="True"/>
            <field name="body_html" type="html">
                <p>Dear <t t-out="object.partner_id.name or ''">Customer</t>,</p>
                <p>Please find attached the reception document for Service Order
                    <strong t-out="object.name or ''">RO-00000</strong>.</p>
                <p>Best regards,</p>
                <p t-out="object.company_id.name or ''">Your company</p>
            </field>
            <field name="report_template_ids" eval="[(4, ref('vehicle_service.action_report_reception_document'))]"/>
        </record>
    </data>
</odoo>
