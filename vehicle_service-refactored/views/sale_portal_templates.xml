<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sale_order_portal_content_inherit_workshop" inherit_id="sale.sale_order_portal_content">
        <xpath expr="//div[@id='informations']" position="inside">
            <t t-if="sale_order.service_type == 'repair'">
                <div class="row mt-3">
                    <div class="col-12">
                        <strong>Vehicle Details:</strong>
                        <p class="m-0">License Plate: <span t-field="sale_order.vehicle_id.license_plate"/> | Mileage: <span t-field="sale_order.current_mileage"/></p>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

    <template id="portal_my_orders_reception_button" inherit_id="sale.sale_order_portal_template">
        <xpath expr="//div[hasclass('o_download_pdf')]" position="inside">
            <t t-if="sale_order.service_type == 'repair'">
                <a class="btn btn-secondary btn-block mt-2" 
                   t-att-href="'/report/pdf/vehicle_service.report_vehicle_reception/' + str(sale_order.id)" 
                   target="_blank">
                    <i class="fa fa-print"/> Print Reception
                </a>
            </t>
        </xpath>
    </template>
</odoo>